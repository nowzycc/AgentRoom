{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://npc.local/schemas/v1/envelope.schema.json",
  "title": "NPC runtime v1 fact envelope",
  "description": "Structural envelope for an external fact. Type-specific payloads are constrained by event.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "eventId",
    "source",
    "sourceEpoch",
    "sequence",
    "worldId",
    "actorId",
    "type",
    "occurredAt",
    "data"
  ],
  "properties": {
    "specVersion": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/specVersion" },
    "eventId": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/id" },
    "source": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/source" },
    "sourceEpoch": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "worldId": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/id" },
    "actorId": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/id" },
    "sessionId": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/id" },
    "runId": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/id" },
    "type": {
      "enum": [
        "run.started",
        "run.completed",
        "tool.started",
        "tool.completed",
        "speech.started",
        "speech.completed",
        "presence.heartbeat"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "$ref": "https://npc.local/schemas/v1/common.schema.json#/$defs/id" },
    "data": { "type": "object" }
  }
}
