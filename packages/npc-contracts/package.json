{
  "name": "@npc/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NPC runtime v2 protocol contracts: JSON Schemas, TS types and strict parsers",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
